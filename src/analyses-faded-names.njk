---
permalink: /analyses/faded-names/
---

{% extends "base.njk" %}

{% block title %}Faded Names - Analyses - {{ siteConfig.title }}{% endblock %}
{% block description %}Heatmaps and cluster analyses of historic top-100 names that are no longer ranked in 2024{% endblock %}

{% macro memberRow(member, decades) %}
  <tr class="hover:bg-gray-50">
    <td class="sticky left-0 bg-white hover:bg-gray-50 px-3 py-1 text-sm whitespace-nowrap border-r border-gray-200">
      <a href="/names/{{ 'boy' if member.gender == 'Boy' else 'girl' }}/{{ member.uniqueSlug }}/" class="text-blue-600 hover:underline font-medium">{{ member.name }}</a>
      <span class="ml-1 text-[10px] text-gray-400">{{ 'M' if member.gender == 'Boy' else 'F' }}</span>
    </td>
    {% for t in member.ternary %}
      {% if t == 2 %}
        {% set cls = 'bg-green-600' %}
        {% set lbl = 'top 30 (#' + (member.ranks[loop.index0]|string) + ')' %}
      {% elif t == 1 %}
        {% set cls = 'bg-green-200' %}
        {% set lbl = '31–100 (#' + (member.ranks[loop.index0]|string) + ')' %}
      {% else %}
        {% set cls = 'bg-white' %}
        {% set lbl = 'outside top 100' %}
      {% endif %}
      <td class="heatmap-cell {{ cls }}" title="{{ member.name }} — {{ decades[loop.index0] }}: {{ lbl }}"></td>
    {% endfor %}
  </tr>
{% endmacro %}

{% block content %}
<article class="bg-white rounded-lg p-6 sm:p-8 shadow-sm">
  <div class="mb-6">
    <div class="mb-2">
      <a href="/analyses/" class="text-green-600 hover:text-green-700 text-sm">&larr; All Analyses</a>
    </div>
    <h1 class="text-4xl font-bold mb-2 text-gray-900">Faded Names</h1>
    <p class="text-lg text-gray-600 max-w-3xl">
      Every historic top-100 name that is no longer ranked in 2024. Each row is a name; each column is a decade from 1904 to 2024.
    </p>
    <p class="text-sm text-gray-500 mt-2">
      {{ fadedNames.total | formatNumber }} names in total, sorted by first and last decade of top-100 presence.
    </p>
  </div>

  <div class="mb-8 flex flex-wrap gap-4 items-center text-sm text-gray-700">
    <span class="font-semibold">Legend:</span>
    <span class="inline-flex items-center gap-2"><span class="inline-block w-4 h-4 bg-green-600 border border-gray-200"></span>Top 30</span>
    <span class="inline-flex items-center gap-2"><span class="inline-block w-4 h-4 bg-green-200 border border-gray-200"></span>31–100</span>
    <span class="inline-flex items-center gap-2"><span class="inline-block w-4 h-4 bg-white border border-gray-200"></span>Outside top 100</span>
  </div>

  <section class="mb-16">
    <h2 class="text-2xl font-bold mb-4 text-gray-900 border-b-2 border-gray-300 pb-2">All faded names</h2>
    <div class="overflow-x-auto">
      <table class="border-collapse w-full">
        <thead>
          <tr>
            <th class="sticky left-0 bg-white text-left px-3 py-2 text-[11px] font-semibold text-gray-600 uppercase tracking-wider border-b border-r border-gray-200">Name</th>
            {% for decade in fadedNames.decades %}
            <th class="px-1 py-2 text-[10px] font-semibold text-gray-600 border-b border-gray-200">{{ decade }}</th>
            {% endfor %}
          </tr>
        </thead>
        <tbody>
          {% for m in fadedNames.all %}
            {{ memberRow(m, fadedNames.decades) }}
          {% endfor %}
        </tbody>
      </table>
    </div>
  </section>

  <section class="mb-8">
    <h2 class="text-2xl font-bold mb-2 text-gray-900 border-b-2 border-gray-300 pb-2">Clusters</h2>
    <p class="text-gray-600 mt-3 max-w-3xl">
      Three methods each partition these names into five labelled clusters:
    </p>
    <ul class="mt-3 text-sm text-gray-700 grid sm:grid-cols-2 gap-x-6 gap-y-1 max-w-3xl">
      {% for label in fadedNames.labels %}
      <li><span class="font-semibold text-gray-900">{{ label }}.</span> {{ fadedNames.descriptions[label] }}</li>
      {% endfor %}
    </ul>
  </section>

  <div class="space-y-16">
    {% for method in fadedNames.methods %}
    <section>
      <header class="mb-4">
        <h3 class="text-2xl font-bold text-gray-900">{{ method.name }}</h3>
        <p class="text-sm text-gray-600 mt-2 max-w-3xl">{{ method.description }}</p>
      </header>

      <div class="space-y-6">
        {% for cluster in method.clusters %}
        <section class="border border-gray-200 rounded-lg overflow-hidden">
          <header class="bg-gray-50 border-b border-gray-200 px-4 py-3 flex flex-wrap items-baseline justify-between gap-2">
            <h4 class="text-lg font-bold text-gray-900">
              {{ cluster.label }}
              <span class="ml-2 text-sm font-normal text-gray-600">{{ cluster.description }}</span>
            </h4>
            <span class="text-sm text-gray-600">{{ cluster.count | formatNumber }} names</span>
          </header>

          <div class="px-4 py-3 border-b border-gray-200 bg-white">
            <div class="text-xs uppercase tracking-wider font-semibold text-gray-500 mb-2">Centroid (share of cluster in top 100 each decade)</div>
            <table class="border-collapse">
              <thead>
                <tr>
                  {% for decade in fadedNames.decades %}
                  <th class="px-1 py-1 text-[10px] font-semibold text-gray-600">{{ decade }}</th>
                  {% endfor %}
                </tr>
              </thead>
              <tbody>
                <tr>
                  {% for value in cluster.centroid %}
                  <td class="centroid-cell" style="background: rgba(22, 163, 74, {{ value }});" title="{{ fadedNames.decades[loop.index0] }}: {{ (value * 100) | round }}%"></td>
                  {% endfor %}
                </tr>
              </tbody>
            </table>
          </div>

          <div class="px-4 py-3 bg-white">
            <div class="text-xs uppercase tracking-wider font-semibold text-gray-500 mb-2">Members</div>
            {% if cluster.count == 0 %}
            <p class="text-sm text-gray-500 italic">No names assigned to this cluster.</p>
            {% else %}
            <div class="overflow-x-auto">
              <table class="border-collapse w-full">
                <thead>
                  <tr>
                    <th class="sticky left-0 bg-white text-left px-3 py-1 text-[11px] font-semibold text-gray-600 uppercase tracking-wider border-b border-r border-gray-200">Name</th>
                    {% for decade in fadedNames.decades %}
                    <th class="px-1 py-1 text-[10px] font-semibold text-gray-600 border-b border-gray-200">{{ decade }}</th>
                    {% endfor %}
                  </tr>
                </thead>
                <tbody>
                  {% for member in cluster.members %}
                    {{ memberRow(member, fadedNames.decades) }}
                  {% endfor %}
                </tbody>
              </table>
            </div>
            {% endif %}
          </div>
        </section>
        {% endfor %}
      </div>
    </section>
    {% endfor %}
  </div>
</article>

<style>
  .heatmap-cell {
    width: 20px;
    min-width: 20px;
    height: 18px;
    padding: 0;
    border: 1px solid #e5e7eb;
  }
  .centroid-cell {
    width: 28px;
    min-width: 28px;
    height: 24px;
    padding: 0;
    border: 1px solid #e5e7eb;
  }
</style>
{% endblock %}
