---
pagination:
  data: allNames
  size: 1
  alias: nameData
permalink: /names/{{ nameData.gender | lower }}/{{ nameData.uniqueSlug }}/
---

{% extends "base.njk" %}

{% block title %}{{ nameData.name }} - {{ siteConfig.title }}{% endblock %}
{% block description %}Discover {{ nameData.name }}: A {{ nameData.gender }}'s name ranked #{{ nameData.rank }} with detailed popularity trends and historical data.{% endblock %}

{% block content %}
<article class="bg-white rounded-lg p-8 shadow-sm">
  <h1 class="text-5xl font-bold mb-2 text-gray-900">{{ nameData.name }}</h1>

  {% if nameData.gender %}
  <p class="text-xl text-gray-600 mb-8">{{ nameData.gender }}'s Name</p>
  {% endif %}

  <div class="mb-8">
    <table class="min-w-full">
      <tbody class="border-t border-gray-300">
        <tr class="border-b border-gray-300">
          <th scope="row" class="py-3 pr-4 text-left font-normal text-gray-900">Current rank</th>
          <td class="py-3 text-right font-bold text-gray-900">#{{ nameData.rank }}</td>
        </tr>
        <tr class="border-b border-gray-300">
          <th scope="row" class="py-3 pr-4 text-left font-normal text-gray-900">Babies named {{ nameData.name }}</th>
          <td class="py-3 text-right font-bold text-gray-900">{{ nameData.count }}</td>
        </tr>
        {% if nameData.classifications and nameData.classifications.recent %}
        <tr class="border-b border-gray-300">
          <th scope="row" class="py-3 pr-4 text-left font-normal text-gray-900">Modern (1996-2024)</th>
          <td class="py-3 text-right">
            <a href="/classifications/recent/{{ nameData.classifications.recent | lower | replace(' ', '-') | replace('(', '') | replace(')', '') }}/" class="inline-block px-3 py-1 bg-blue-50 text-blue-700 rounded-md hover:bg-blue-100 transition-colors font-medium text-sm border border-blue-200">
              {{ nameData.classifications.recent }}
            </a>
          </td>
        </tr>
        {% endif %}
        {% if nameData.classifications and nameData.classifications.historic %}
        <tr class="border-b border-gray-300">
          <th scope="row" class="py-3 pr-4 text-left font-normal text-gray-900">Historic (1904-2024)</th>
          <td class="py-3 text-right">
            <a href="/classifications/historic/{{ nameData.classifications.historic | lower | replace(' ', '-') | replace('(', '') | replace(')', '') }}/" class="inline-block px-3 py-1 bg-amber-50 text-amber-700 rounded-md hover:bg-amber-100 transition-colors font-medium text-sm border border-amber-200">
              {{ nameData.classifications.historic }}
            </a>
          </td>
        </tr>
        {% endif %}
      </tbody>
    </table>
  </div>

  {% if nameData.bulletPoint1 or nameData.bulletPoint2 or nameData.bulletPoint3 or nameData.bulletPoint4 %}
  <div class="mb-8">
    <h2 class="text-2xl font-bold mb-4 text-gray-900">Summary</h2>
    <ul class="space-y-3">
      {% if nameData.bulletPoint1 %}
      <li class="flex items-start">
        <span class="text-blue-600 mr-3 mt-1 flex-shrink-0">•</span>
        <span class="text-gray-700">{{ nameData.bulletPoint1 }}</span>
      </li>
      {% endif %}
      {% if nameData.bulletPoint2 %}
      <li class="flex items-start">
        <span class="text-blue-600 mr-3 mt-1 flex-shrink-0">•</span>
        <span class="text-gray-700">{{ nameData.bulletPoint2 }}</span>
      </li>
      {% endif %}
      {% if nameData.bulletPoint3 %}
      <li class="flex items-start">
        <span class="text-blue-600 mr-3 mt-1 flex-shrink-0">•</span>
        <span class="text-gray-700">{{ nameData.bulletPoint3 }}</span>
      </li>
      {% endif %}
      {% if nameData.bulletPoint4 %}
      <li class="flex items-start">
        <span class="text-blue-600 mr-3 mt-1 flex-shrink-0">•</span>
        <span class="text-gray-700">{{ nameData.bulletPoint4 }}</span>
      </li>
      {% endif %}
    </ul>
  </div>
  {% endif %}

  {% set hasHistoricRankData = false %}
  {% if nameData.rankHistoric and nameData.rankHistoric.length > 0 %}
    {% for historicRank in nameData.rankHistoric %}
      {% if historicRank and historicRank != 'x' %}
        {% set hasHistoricRankData = true %}
      {% endif %}
    {% endfor %}
  {% endif %}

  {% if hasHistoricRankData %}
  <div class="mb-8">
    <h2 class="text-2xl font-bold mb-2 text-gray-900">Historic Rankings</h2>
    <p class="text-gray-700 mb-4">Top 100 rankings from 1904 to 2024</p>

    {% if nameData.classifications and nameData.classifications.historic %}
    <div class="mb-4 bg-amber-50 rounded-lg p-4 border-l-4 border-amber-500">
      <p class="text-sm font-semibold text-gray-700 mb-1">
        Classification:
        <a href="/classifications/historic/{{ nameData.classifications.historic | lower | replace(' ', '-') | replace('(', '') | replace(')', '') }}/" class="text-amber-600 hover:text-amber-700 hover:underline">{{ nameData.classifications.historic }}</a>
      </p>
      {% if classificationDescriptions.historic[nameData.classifications.historic] %}
      <p class="text-sm text-gray-600">{{ classificationDescriptions.historic[nameData.classifications.historic] }}</p>
      {% endif %}
    </div>
    {% endif %}

    {% set defaultHistoricTab = 'rank' %}
    <div class="mb-4">
      <div class="border-b border-gray-200">
        <nav id="historic-tabs" class="-mb-px flex gap-6" aria-label="Historic data selection" role="tablist" data-default-tab="{{ defaultHistoricTab }}">
          <button
            type="button"
            id="historic-tab-rank"
            data-historic-tab="rank"
            role="tab"
            tabindex="0"
            aria-selected="true"
            aria-controls="historic-rank-wrapper"
            class="historic-tab border-b-2 border-amber-600 py-3 px-1 text-sm font-semibold text-amber-600"
          >
            By rank
          </button>
          <button
            type="button"
            id="historic-tab-data"
            data-historic-tab="data"
            role="tab"
            tabindex="-1"
            aria-selected="false"
            aria-controls="historic-data-wrapper"
            class="historic-tab border-b-2 border-transparent py-3 px-1 text-sm font-semibold text-gray-500 hover:border-gray-300 hover:text-gray-700"
          >
            Data
          </button>
        </nav>
      </div>
    </div>

    <div id="historic-rank-wrapper" class="w-full mb-4 {% if defaultHistoricTab != 'rank' %}hidden{% endif %}" role="tabpanel" aria-labelledby="historic-tab-rank" aria-hidden="{% if defaultHistoricTab == 'rank' %}false{% else %}true{% endif %}">
      <h3 class="text-lg font-semibold mb-2 text-gray-900">Historic popularity by rank</h3>
      <div id="historic-chart" class="w-full" style="height: 300px;"></div>
    </div>

    <div id="historic-data-wrapper" class="w-full mb-4 {% if defaultHistoricTab != 'data' %}hidden{% endif %}" role="tabpanel" aria-labelledby="historic-tab-data" aria-hidden="{% if defaultHistoricTab == 'data' %}false{% else %}true{% endif %}">
      <div class="bg-white rounded-lg overflow-hidden border border-gray-200">
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Decade</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Rank</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              {% for historicRank in nameData.rankHistoric %}
              <tr class="{% if loop.index0 % 2 == 0 %}bg-white{% else %}bg-gray-50{% endif %}">
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{{ 1910 + (loop.index0 * 10) }}s</td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                  {% if historicRank and historicRank != 'x' %}#{{ historicRank }}{% else %}Not in top 100{% endif %}
                </td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
  {% endif %}

  {% if nameData.rankFrom1996 and nameData.rankFrom1996.length > 0 %}
  <div class="mb-8">
    <h2 class="text-2xl font-bold mb-2 text-gray-900">Modern Rankings</h2>
    <p class="text-gray-700 mb-4">Rankings from 1996 to 2024 (29 years)</p>
    {% set hasModernCountData = nameData.countFrom1996 and nameData.countFrom1996.length > 0 %}
    {% set defaultModernTab = 'rank' %}

    {% if nameData.classifications and nameData.classifications.recent %}
    <div class="mb-4 bg-blue-50 rounded-lg p-4 border-l-4 border-blue-500">
      <p class="text-sm font-semibold text-gray-700 mb-1">
        Classification:
        <a href="/classifications/recent/{{ nameData.classifications.recent | lower | replace(' ', '-') | replace('(', '') | replace(')', '') }}/" class="text-blue-600 hover:text-blue-700 hover:underline">{{ nameData.classifications.recent }}</a>
      </p>
      {% if classificationDescriptions.recent[nameData.classifications.recent] %}
      <p class="text-sm text-gray-600">{{ classificationDescriptions.recent[nameData.classifications.recent] }}</p>
      {% endif %}
    </div>
    {% endif %}

    <div class="mb-4">
      <div class="border-b border-gray-200">
        <nav id="modern-tabs" class="-mb-px flex gap-6" aria-label="Modern data selection" role="tablist" data-default-tab="{{ defaultModernTab }}">
          <button
            type="button"
            id="modern-tab-rank"
            data-modern-tab="rank"
            role="tab"
            tabindex="0"
            aria-selected="true"
            aria-controls="modern-rank-chart-wrapper"
            class="modern-tab border-b-2 border-blue-600 py-3 px-1 text-sm font-semibold text-blue-600"
          >
            By rank
          </button>
          <button
            type="button"
            id="modern-tab-count"
            data-modern-tab="count"
            role="tab"
            tabindex="-1"
            aria-selected="false"
            aria-controls="modern-count-chart-wrapper"
            class="modern-tab border-b-2 border-transparent py-3 px-1 text-sm font-semibold text-gray-500 hover:border-gray-300 hover:text-gray-700"
          >
            By count
          </button>
          <button
            type="button"
            id="modern-tab-data"
            data-modern-tab="data"
            role="tab"
            tabindex="-1"
            aria-selected="false"
            aria-controls="modern-data-wrapper"
            class="modern-tab border-b-2 border-transparent py-3 px-1 text-sm font-semibold text-gray-500 hover:border-gray-300 hover:text-gray-700"
          >
            Data
          </button>
        </nav>
      </div>
    </div>

    <div id="modern-count-chart-wrapper" class="w-full mb-4 {% if defaultModernTab != 'count' %}hidden{% endif %}" role="tabpanel" aria-labelledby="modern-tab-count" aria-hidden="{% if defaultModernTab == 'count' %}false{% else %}true{% endif %}">
      <h3 class="text-lg font-semibold mb-2 text-gray-900">Modern popularity by number of babies</h3>
      {% if hasModernCountData %}
      <div id="modern-count-chart" class="w-full" style="height: 400px;"></div>
      {% else %}
      <p class="text-sm text-gray-500 pt-2">No modern count data available.</p>
      {% endif %}
    </div>
    <div id="modern-rank-chart-wrapper" class="w-full mb-4 {% if defaultModernTab != 'rank' %}hidden{% endif %}" role="tabpanel" aria-labelledby="modern-tab-rank" aria-hidden="{% if defaultModernTab == 'rank' %}false{% else %}true{% endif %}">
      <h3 class="text-lg font-semibold mb-2 text-gray-900">Modern popularity by rank</h3>
      <div id="modern-rank-chart" class="w-full" style="height: 400px;"></div>
    </div>

    <div id="modern-data-wrapper" class="w-full mb-4 {% if defaultModernTab != 'data' %}hidden{% endif %}" role="tabpanel" aria-labelledby="modern-tab-data" aria-hidden="{% if defaultModernTab == 'data' %}false{% else %}true{% endif %}">
      <div class="bg-white rounded-lg overflow-hidden border border-gray-200">
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Year</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Rank</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Babies Named</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              {% for modernRank in nameData.rankFrom1996 %}
              {% set modernYear = 1996 + loop.index0 %}
              {% set modernCount = null %}
              {% if hasModernCountData %}
                {% set modernCount = nameData.countFrom1996[loop.index0] %}
              {% endif %}
              <tr class="{% if loop.index0 % 2 == 0 %}bg-white{% else %}bg-gray-50{% endif %}">
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{{ modernYear }}</td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                  {% if modernRank and modernRank != 'x' %}#{{ modernRank }}{% else %}Unranked{% endif %}
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                  {% if modernCount and modernCount != 'x' %}{{ modernCount }}{% else %}—{% endif %}
                </td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
  {% endif %}

  {% if nameData.relatedNamesWithRank and nameData.relatedNamesWithRank.length > 0 %}
  <div class="mb-8">
    <h2 class="text-2xl font-bold mb-2 text-gray-900">Related Names</h2>
    <p class="text-gray-700 mb-4">Names related to {{ nameData.name }}</p>

    <div class="mb-4 bg-white rounded-lg overflow-hidden border border-gray-200">
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Rank</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Count</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            {% set rankedNames = [] %}
            {% set unrankedNames = [] %}
            {% for relName in nameData.relatedNamesWithRank %}
              {% if relName.rank %}
                {% set _ = rankedNames.push(relName) %}
              {% else %}
                {% set _ = unrankedNames.push(relName) %}
              {% endif %}
            {% endfor %}
            {% set sortedRanked = rankedNames | sort(false, false, 'rank') %}
            {% for relName in sortedRanked %}
            <tr class="{% if loop.index0 % 2 == 0 %}bg-white{% else %}bg-gray-50{% endif %} hover:bg-purple-50">
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                {% if relName.uniqueSlug and relName.gender %}
                  <a href="/names/{{ relName.gender | lower }}/{{ relName.uniqueSlug }}/" class="text-blue-600 hover:text-blue-700 hover:underline">{{ relName.name }}</a>
                {% else %}
                  {{ relName.name }}
                {% endif %}
                {% if relName.gender %}
                  <span class="text-gray-500 text-xs ml-1">({{ relName.gender }})</span>
                {% endif %}
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-purple-600 font-semibold">#{{ relName.rank }}</td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{% if relName.count %}{{ relName.count }}{% else %}—{% endif %}</td>
            </tr>
            {% endfor %}
            {% for relName in unrankedNames %}
            <tr class="{% if loop.index0 % 2 == 0 %}bg-white{% else %}bg-gray-50{% endif %} hover:bg-purple-50">
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                {% if relName.uniqueSlug and relName.gender %}
                  <a href="/names/{{ relName.gender | lower }}/{{ relName.uniqueSlug }}/" class="text-blue-600 hover:text-blue-700 hover:underline">{{ relName.name }}</a>
                {% else %}
                  {{ relName.name }}
                {% endif %}
                {% if relName.gender %}
                  <span class="text-gray-500 text-xs ml-1">({{ relName.gender }})</span>
                {% endif %}
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-400">Unranked</td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{% if relName.count %}{{ relName.count }}{% else %}—{% endif %}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>

    {% set totalWithRelated = nameData.count | int %}
    {% for relName in nameData.relatedNamesWithRank %}
      {% if relName.count %}
        {% set totalWithRelated = totalWithRelated + (relName.count | int) %}
      {% endif %}
    {% endfor %}

    <div class="mb-4">
      <table class="min-w-full">
        <tbody class="border-t border-gray-300">
          <tr class="border-b border-gray-300">
            <th scope="row" class="py-3 pr-4 text-left font-normal text-gray-900">Total including all related names</th>
            <td class="py-3 text-right font-bold text-gray-900">{{ totalWithRelated }}</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
  {% endif %}

  <nav class="pt-6 border-t border-gray-200">
    <a href="/names/" class="text-blue-600 hover:text-blue-700 font-medium">&larr; Back to all names</a>
  </nav>
</article>

<script>
  // Tabs for historic chart/data
  {% if hasHistoricRankData %}
  (function() {
    const tabContainer = document.getElementById('historic-tabs');
    if (!tabContainer) return;

    const tabs = Array.from(tabContainer.querySelectorAll('[data-historic-tab]'));
    const views = {
      rank: document.getElementById('historic-rank-wrapper'),
      data: document.getElementById('historic-data-wrapper')
    };
    const defaultTab = tabContainer.dataset.defaultTab || 'rank';

    function setActiveTab(tabName) {
      tabs.forEach(tab => {
        const isActive = tab.dataset.historicTab === tabName;
        tab.classList.toggle('border-amber-600', isActive);
        tab.classList.toggle('text-amber-600', isActive);
        tab.classList.toggle('border-transparent', !isActive);
        tab.classList.toggle('text-gray-500', !isActive);
        tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
        tab.setAttribute('tabindex', isActive ? '0' : '-1');
      });

      Object.entries(views).forEach(([name, el]) => {
        if (!el) return;
        const isVisible = name === tabName;
        el.classList.toggle('hidden', !isVisible);
        el.setAttribute('aria-hidden', isVisible ? 'false' : 'true');
      });

      if (tabName === 'rank' && typeof window.renderHistoricChart === 'function') {
        window.renderHistoricChart();
      }
    }

    tabs.forEach(tab => {
      tab.addEventListener('click', () => setActiveTab(tab.dataset.historicTab));
      tab.addEventListener('keydown', event => {
        const currentIndex = tabs.indexOf(tab);
        let nextIndex = -1;
        if (event.key === 'ArrowRight') {
          nextIndex = (currentIndex + 1) % tabs.length;
        } else if (event.key === 'ArrowLeft') {
          nextIndex = (currentIndex - 1 + tabs.length) % tabs.length;
        } else if (event.key === 'Home') {
          nextIndex = 0;
        } else if (event.key === 'End') {
          nextIndex = tabs.length - 1;
        }
        if (nextIndex !== -1) {
          event.preventDefault();
          const nextTab = tabs[nextIndex];
          nextTab.focus();
          setActiveTab(nextTab.dataset.historicTab);
        }
      });
    });

    setActiveTab(defaultTab);
  })();
  {% endif %}

  // Tabs for modern rank/count/data
  {% if nameData.rankFrom1996 and nameData.rankFrom1996.length > 0 %}
  (function() {
    const tabContainer = document.getElementById('modern-tabs');
    if (!tabContainer) return;

    const tabs = Array.from(tabContainer.querySelectorAll('[data-modern-tab]'));
    const views = {
      count: document.getElementById('modern-count-chart-wrapper'),
      rank: document.getElementById('modern-rank-chart-wrapper'),
      data: document.getElementById('modern-data-wrapper')
    };
    const defaultTab = tabContainer.dataset.defaultTab || 'rank';

    function setActiveTab(tabName) {
      tabs.forEach(tab => {
        const isActive = tab.dataset.modernTab === tabName;
        tab.classList.toggle('border-blue-600', isActive);
        tab.classList.toggle('text-blue-600', isActive);
        tab.classList.toggle('border-transparent', !isActive);
        tab.classList.toggle('text-gray-500', !isActive);
        tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
        tab.setAttribute('tabindex', isActive ? '0' : '-1');
      });

      Object.entries(views).forEach(([name, el]) => {
        if (!el) return;
        const isVisible = name === tabName;
        el.classList.toggle('hidden', !isVisible);
        el.setAttribute('aria-hidden', isVisible ? 'false' : 'true');
      });

      if (tabName === 'count' && typeof window.renderModernCountChart === 'function') {
        window.renderModernCountChart();
      }
      if (tabName === 'rank' && typeof window.renderModernRankChart === 'function') {
        window.renderModernRankChart();
      }
    }

    tabs.forEach(tab => {
      tab.addEventListener('click', () => setActiveTab(tab.dataset.modernTab));
      tab.addEventListener('keydown', event => {
        const currentIndex = tabs.indexOf(tab);
        let nextIndex = -1;
        if (event.key === 'ArrowRight') {
          nextIndex = (currentIndex + 1) % tabs.length;
        } else if (event.key === 'ArrowLeft') {
          nextIndex = (currentIndex - 1 + tabs.length) % tabs.length;
        } else if (event.key === 'Home') {
          nextIndex = 0;
        } else if (event.key === 'End') {
          nextIndex = tabs.length - 1;
        }
        if (nextIndex !== -1) {
          event.preventDefault();
          const nextTab = tabs[nextIndex];
          nextTab.focus();
          setActiveTab(nextTab.dataset.modernTab);
        }
      });
    });

    setActiveTab(defaultTab);
  })();
  {% endif %}
</script>

<script>
  // Modern rankings dot plot with count on y-axis
  {% if nameData.countFrom1996 and nameData.countFrom1996.length > 0 %}
  (function() {
    const countData = {{ nameData.countFrom1996 | dump | safe }};
    const startYear = 1996;

    // Prepare main data (name's own count)
    const chartData = countData.map((count, i) => ({
      year: startYear + i,
      count: count === 'x' ? null : parseInt(count)
    })).filter(d => d.count !== null);

    // Find min and max counts
    const allCounts = chartData.map(d => d.count);
    const maxCount = allCounts.length > 0 ? Math.max(...allCounts) : 0;

    const yMax = maxCount;

    const container = document.getElementById('modern-count-chart');
    const margin = {top: 20, right: 40, bottom: 60, left: 60};

    function drawChart() {
      d3.select('#modern-count-chart').selectAll('*').remove();

      const containerWidth = container.clientWidth;
      const width = containerWidth - margin.left - margin.right;
      const height = 400 - margin.top - margin.bottom;

      const svg = d3.select('#modern-count-chart')
        .append('svg')
        .attr('width', containerWidth)
        .attr('height', 400)
        .append('g')
        .attr('transform', `translate(${margin.left},${margin.top})`);

      // X scale for years (horizontal)
      const xScale = d3.scaleLinear()
        .domain([1996, 2024])
        .range([0, width]);

      // Y scale for count (vertical)
      const yScale = d3.scaleLinear()
        .domain([0, yMax || 1])
        .range([height, 0]);

      // Add X axis
      svg.append('g')
        .attr('transform', `translate(0,${height})`)
        .call(d3.axisBottom(xScale)
          .ticks(7)
          .tickFormat(d3.format('d')))
        .style('font-size', '12px');

      // Add X axis label
      svg.append('text')
        .attr('x', width / 2)
        .attr('y', height + 50)
        .attr('text-anchor', 'middle')
        .style('font-size', '14px')
        .style('fill', '#6b7280')
        .text('Year');

      // Add Y axis
      svg.append('g')
        .call(d3.axisLeft(yScale)
          .ticks(5)
          .tickFormat(d3.format(',d')))
        .style('font-size', '12px');

      // Add Y axis label
      svg.append('text')
        .attr('transform', 'rotate(-90)')
        .attr('x', -height / 2)
        .attr('y', -45)
        .attr('text-anchor', 'middle')
        .style('font-size', '14px')
        .style('fill', '#6b7280')
        .text('Number of Babies');

      // Add main series dots
      svg.selectAll('.dot')
        .data(chartData)
        .join('circle')
        .attr('class', 'dot')
        .attr('cx', d => xScale(d.year))
        .attr('cy', d => yScale(d.count))
        .attr('r', 4)
        .attr('fill', '#3b82f6')
        .attr('opacity', 0.7)
        .on('mouseover', function(event, d) {
          d3.select(this)
            .attr('r', 6)
            .attr('opacity', 1);

          // Show tooltip
          const tooltip = svg.append('g')
            .attr('class', 'tooltip')
            .attr('transform', `translate(${xScale(d.year) + 10},${yScale(d.count)})`);

          const text = tooltip.append('text')
            .attr('text-anchor', 'start')
            .style('font-size', '11px')
            .style('font-weight', '600')
            .style('fill', '#1e40af')
            .text(`${d.year}: ${d.count.toLocaleString()} babies`);

          const bbox = text.node().getBBox();
          tooltip.insert('rect', 'text')
            .attr('x', bbox.x - 4)
            .attr('y', bbox.y - 2)
            .attr('width', bbox.width + 8)
            .attr('height', bbox.height + 4)
            .attr('fill', 'white')
            .attr('stroke', '#3b82f6')
            .attr('stroke-width', 1)
            .attr('rx', 3);

          text.raise();
        })
        .on('mouseout', function() {
          d3.select(this)
            .attr('r', 4)
            .attr('opacity', 0.7);
          svg.selectAll('.tooltip').remove();
        });
    }

    const chartWrapper = document.getElementById('modern-count-chart-wrapper');
    window.renderModernCountChart = drawChart;
    if (!chartWrapper || !chartWrapper.classList.contains('hidden')) {
      drawChart();
    }

    // Redraw on window resize
    let resizeTimeout;
    window.addEventListener('resize', function() {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(() => {
        if (!chartWrapper || !chartWrapper.classList.contains('hidden')) {
          drawChart();
        }
      }, 250);
    });
  })();
  {% endif %}
</script>

<script>
  // Modern rankings dot plot with rank on y-axis
  {% if nameData.rankFrom1996 and nameData.rankFrom1996.length > 0 %}
  (function() {
    const rankDataRaw = {{ nameData.rankFrom1996 | dump | safe }};
    const startYear = 1996;
    const chartData = rankDataRaw.map((rank, i) => ({
      year: startYear + i,
      rank: rank === 'x' ? null : parseInt(rank)
    })).filter(d => d.rank !== null && !Number.isNaN(d.rank));

    const allRanks = chartData.map(d => d.rank);
    const maxRank = allRanks.length > 0 ? Math.max(...allRanks) : 1;
    const minRank = allRanks.length > 0 ? Math.min(...allRanks) : 1;

    const container = document.getElementById('modern-rank-chart');
    const margin = {top: 20, right: 40, bottom: 60, left: 60};

    function drawChart() {
      d3.select('#modern-rank-chart').selectAll('*').remove();

      if (chartData.length === 0) {
        d3.select('#modern-rank-chart')
          .append('p')
          .attr('class', 'text-sm text-gray-500 pt-2')
          .text('No modern rank data available.');
        return;
      }

      const containerWidth = container.clientWidth;
      const width = containerWidth - margin.left - margin.right;
      const height = 400 - margin.top - margin.bottom;

      const svg = d3.select('#modern-rank-chart')
        .append('svg')
        .attr('width', containerWidth)
        .attr('height', 400)
        .append('g')
        .attr('transform', `translate(${margin.left},${margin.top})`);

      const xScale = d3.scaleLinear()
        .domain([1996, 2024])
        .range([0, width]);

      const yScale = d3.scaleLinear()
        // Inverted domain ensures lower numeric ranks (e.g., #1) render higher.
        .domain([maxRank, minRank])
        .range([height, 0]);

      svg.append('g')
        .attr('transform', `translate(0,${height})`)
        .call(d3.axisBottom(xScale)
          .ticks(7)
          .tickFormat(d3.format('d')))
        .style('font-size', '12px');

      svg.append('text')
        .attr('x', width / 2)
        .attr('y', height + 50)
        .attr('text-anchor', 'middle')
        .style('font-size', '14px')
        .style('fill', '#6b7280')
        .text('Year');

      svg.append('g')
        .call(d3.axisLeft(yScale).ticks(5).tickFormat(d3.format('d')))
        .style('font-size', '12px');

      svg.append('text')
        .attr('transform', 'rotate(-90)')
        .attr('x', -height / 2)
        .attr('y', -45)
        .attr('text-anchor', 'middle')
        .style('font-size', '14px')
        .style('fill', '#6b7280')
        .text('Rank (1 = Most Popular)');

      svg.selectAll('.dot')
        .data(chartData)
        .join('circle')
        .attr('class', 'dot')
        .attr('cx', d => xScale(d.year))
        .attr('cy', d => yScale(d.rank))
        .attr('r', 4)
        .attr('fill', '#dc2626')
        .attr('opacity', 0.8)
        .on('mouseover', function(event, d) {
          d3.select(this)
            .attr('r', 6)
            .attr('opacity', 1);

          const tooltip = svg.append('g')
            .attr('class', 'tooltip')
            .attr('transform', `translate(${xScale(d.year) + 10},${yScale(d.rank)})`);

          const text = tooltip.append('text')
            .attr('text-anchor', 'start')
            .style('font-size', '11px')
            .style('font-weight', '600')
            .style('fill', '#991b1b')
            .text(`${d.year}: #${d.rank}`);

          const bbox = text.node().getBBox();
          tooltip.insert('rect', 'text')
            .attr('x', bbox.x - 4)
            .attr('y', bbox.y - 2)
            .attr('width', bbox.width + 8)
            .attr('height', bbox.height + 4)
            .attr('fill', 'white')
            .attr('stroke', '#dc2626')
            .attr('stroke-width', 1)
            .attr('rx', 3);

          text.raise();
        })
        .on('mouseout', function() {
          d3.select(this)
            .attr('r', 4)
            .attr('opacity', 0.8);
          svg.selectAll('.tooltip').remove();
        });
    }

    const chartWrapper = document.getElementById('modern-rank-chart-wrapper');
    window.renderModernRankChart = drawChart;
    if (!chartWrapper || !chartWrapper.classList.contains('hidden')) {
      drawChart();
    }

    let resizeTimeout;
    window.addEventListener('resize', function() {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(() => {
        if (!chartWrapper || !chartWrapper.classList.contains('hidden')) {
          drawChart();
        }
      }, 250);
    });
  })();
  {% endif %}
</script>

<script>
  // Historic rankings chart
  {% if hasHistoricRankData %}
  (function() {
    const data = {{ nameData.rankHistoric | dump | safe }};
    const decades = data.map((rank, i) => ({
      decade: (1900 + i * 10) + 's',
      rank: rank === 'x' ? null : parseInt(rank),
      index: i
    }));

    // Set up dimensions
    const container = document.getElementById('historic-chart');
    const margin = {top: 20, right: 40, bottom: 60, left: 60};

    function drawChart() {
      // Clear previous chart
      d3.select('#historic-chart').selectAll('*').remove();

      const containerWidth = container.clientWidth;
      const width = containerWidth - margin.left - margin.right;
      const height = 300 - margin.top - margin.bottom;

      // Create SVG
      const svg = d3.select('#historic-chart')
        .append('svg')
        .attr('width', containerWidth)
        .attr('height', 300)
        .append('g')
        .attr('transform', `translate(${margin.left},${margin.top})`);

      // Create scales
      const xScale = d3.scaleLinear()
        .domain([100, 1])  // Inverted: 100 to 1
        .range([0, width]);

      const yScale = d3.scaleBand()
        .domain(decades.map(d => d.decade))
        .range([0, height])
        .padding(0.2);

      // Add X axis
      svg.append('g')
        .attr('transform', `translate(0,${height})`)
        .call(d3.axisBottom(xScale).ticks(5))
        .style('font-size', '12px');

      // Add X axis label
      svg.append('text')
        .attr('x', width / 2)
        .attr('y', height + 50)
        .attr('text-anchor', 'middle')
        .style('font-size', '14px')
        .style('fill', '#6b7280')
        .text('Rank (1 = Most Popular)');

      // Add Y axis with decade labels
      svg.append('g')
        .call(d3.axisLeft(yScale))
        .style('font-size', '12px');

      // Add bars
      const bars = svg.selectAll('.bar')
        .data(decades)
        .join(
          enter => enter.append('rect')
            .attr('class', 'bar')
            .call(selection => selection.append('title')),
          update => update,
          exit => exit.remove()
        )
        .attr('x', 0)
        .attr('y', d => yScale(d.decade))
        .attr('width', d => d.rank ? xScale(d.rank) : 0)
        .attr('height', yScale.bandwidth())
        .attr('fill', d => d.rank ? '#93c5fd' : '#e5e7eb')
        .attr('opacity', 1)
        .attr('stroke', d => d.rank ? '#3b82f6' : '#d1d5db')
        .attr('stroke-width', 1)
        .style('cursor', d => d.rank ? 'pointer' : 'default')
        .on('mouseover', function(event, d) {
          if (d.rank) {
            d3.select(this).attr('opacity', 0.8);
          }
        })
        .on('mouseout', function(event, d) {
          if (d.rank) {
            d3.select(this).attr('opacity', 1);
          }
        });

      bars.select('title')
        .text(d => d.rank ? `${d.decade}: #${d.rank}` : `${d.decade}: Not in Top 100`);

      // Add rank labels on bars
      svg.selectAll('.label')
        .data(decades.filter(d => d.rank))
        .join('text')
        .attr('class', 'label')
        .attr('x', d => xScale(d.rank) - 5)
        .attr('y', d => yScale(d.decade) + yScale.bandwidth() / 2)
        .attr('dy', '0.35em')
        .attr('text-anchor', 'end')
        .style('font-size', '12px')
        .style('font-weight', '600')
        .style('fill', '#1e40af')
        .text(d => `#${d.rank}`);
    }

    const chartWrapper = document.getElementById('historic-rank-wrapper');
    window.renderHistoricChart = drawChart;
    if (!chartWrapper || !chartWrapper.classList.contains('hidden')) {
      drawChart();
    }

    // Redraw on window resize
    let resizeTimeout;
    window.addEventListener('resize', function() {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(() => {
        if (!chartWrapper || !chartWrapper.classList.contains('hidden')) {
          drawChart();
        }
      }, 250);
    });
  })();
  {% endif %}
</script>
{% endblock %}
